# Copy to `.env` locally (never commit `.env`).
# Nuxt maps these to runtimeConfig via the NUXT_ prefix.
#
# Contact form → POST /api/contact (server/api/contact.post.ts)
# Without NUXT_RESEND_API_KEY the API returns HTTP 503 "Email service not configured"
# and does NOT pretend the message was sent.

# Resend API key — https://resend.com/api-keys  (REQUIRED for contact delivery)
NUXT_RESEND_API_KEY=

# Destination inbox (optional; defaults to ahmedtaher4550@gmail.com)
NUXT_CONTACT_TO_EMAIL=ahmedtaher4550@gmail.com

# Verified sender in Resend (optional; onboarding@resend.dev works for testing)
NUXT_CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Public site URL for canonical / OG
NUXT_PUBLIC_SITE_URL=https://my-portfolio-pied-delta.vercel.app
