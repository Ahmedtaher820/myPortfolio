# Resend — https://resend.com
# Required for /api/contact to deliver mail. Without it, the API returns a clear config error.
NUXT_RESEND_API_KEY=

# Destination inbox (defaults to ahmedtaher4550@gmail.com)
NUXT_CONTACT_TO_EMAIL=ahmedtaher4550@gmail.com

# Verified sender in Resend (use onboarding@resend.dev for testing)
NUXT_CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Public site URL for canonical / OG
NUXT_PUBLIC_SITE_URL=https://my-portfolio-pied-delta.vercel.app
